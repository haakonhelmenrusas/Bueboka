{
  "expo": {
    "scheme": "bueboka",
    "owner": "rusas_design",
    "web": {
      "bundler": "metro"
    },
    "name": "Bueboka",
    "slug": "bueboka",
    "version": "2.0.2",
    "icon": "./assets/images/icon.png",
    "extra": {
      "eas": {
        "projectId": "a740b024-fdf9-420d-9998-a6ae076ebc43"
      }
    },
    "android": {
      "package": "com.aaronshade.bueboka"
    },
    "ios": {
      "bundleIdentifier": "com.aaronshade.bueboka",
      "infoPlist": {
        "CFBundleShortVersionString": "2.0.2",
        "CFBundleIconName": "./assets/images/ipad.png",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Bueboka trenger tilgang til bilder for at du skal kunne velge profilbilde.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "bueboka"
            ]
          }
        ]
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a740b024-fdf9-420d-9998-a6ae076ebc43",
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "./plugins/withSoftInputMode",
      "expo-font",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#29B6F6",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "bueboka",
          "organization": "haakon-rusas"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bueboka trenger tilgang til bilder for at du skal kunne velge profilbilde."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
